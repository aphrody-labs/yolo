# Aphrody YOLO — Zero-Pollution / Zero-Artifact Rigorous Git Ignore
# No logs, temporary files, caches, build artifacts or untracked state allowed

# Node / Bun dependencies & runtime artifacts
node_modules/
.bun/
*.lockb

# Build & compilation outputs
/dist/
apps/web/dist/
/build/
target/
/out/
/bin/

# Python virtual environments, bytecode & caches
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dylib
*.dll
*.egg-info/
.pytest_cache/
.ruff_cache/

# Temporary directories, caches, runs & mirrors
/var/
/.cache/
.tmp/
/tmp/
*.tmp

# Logs & execution traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.system_generated/
.coord/
.codex/
.gemini/
.claude/

# OS / Editor clutter
.DS_Store
Thumbs.db
*.swp
*.swo
*~
/.idea/
/.vscode/

# Submodules / Externals managed via upstream scripts

# Local secrets
.env
.env.*

# Per-machine plugin store (absolute local path)
/.agents/plugins.json

# Tauri plugin native projects (merged from per-plugin android/ios .gitignore files)
/crates/aphrody-tauri-plugin-*/android/build
/crates/aphrody-tauri-plugin-*/android/.tauri
/crates/aphrody-tauri-plugin-*/ios/.build
/crates/aphrody-tauri-plugin-*/ios/Packages
/crates/aphrody-tauri-plugin-*/ios/*.xcodeproj
/crates/aphrody-tauri-plugin-*/ios/xcuserdata/
/crates/aphrody-tauri-plugin-*/ios/DerivedData/
/crates/aphrody-tauri-plugin-*/ios/.swiftpm/config/registries.json
/crates/aphrody-tauri-plugin-*/ios/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
/crates/aphrody-tauri-plugin-*/ios/.netrc
/crates/aphrody-tauri-plugin-*/ios/Package.resolved
.DS_Store
