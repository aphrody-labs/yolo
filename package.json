{
  "name": "@aphrody/yolo-runtime",
  "version": "1.0.0",
  "description": "Aphrody YOLO Bun Industrial Engine — TypeScript 7 Go, Oxc, Oxlint, Oxfmt & Obscura",
  "type": "module",
  "private": true,
  "author": "aphrody-dev <contact@aphrody.com>",
  "scripts": {
    "status": "bun run scripts/packages_upstream_sync.ts",
    "bun:sync": "bun run scripts/bun_upstream_sync.ts --apply",
    "bun:drift-fix": "bun run scripts/bun_upstream_sync.ts --apply --auto-fix",
    "bun:track": "bun run scripts/bun_upstream_tracker.ts",
    "lint": "bunx oxlint scripts/",
    "fmt": "bunx oxfmt --write scripts/",
    "fmt:check": "bunx oxfmt --check scripts/"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "oxc-parser": "^0.152.0",
    "oxc-transform": "^0.152.0"
  }
}
