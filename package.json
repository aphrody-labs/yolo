{
  "name": "@aphrody/yolo-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Aphrody YOLO Unified Polyglot Engine — Trinity Fork of Bun + Astral uv + PyO3 (Rust + Python + TypeScript / Bun)",
  "license": "MIT",
  "author": "aphrody-dev <contact@aphrody.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/yolo.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "status": "bun run scripts/vendor/packages_upstream_sync.ts",
    "sync:all": "bun run scripts/vendor/packages_upstream_sync.ts --fetch",
    "bun:sync": "bun run scripts/vendor/bun_upstream_sync.ts --apply",
    "bun:drift-fix": "bun run scripts/vendor/bun_upstream_sync.ts --apply --auto-fix",
    "bun:track": "bun run scripts/vendor/bun_upstream_tracker.ts",
    "cli": "bun run apps/cli/src/index.ts",
    "test": "bun test test/",
    "test:cli": "bun test test/cli_app.test.ts",
    "test:py": "uv run --directory packages/python pytest",
    "lint": "oxlint scripts/ test/ packages/ apps/cli/src/ apps/web/src/",
    "lint:py": "ruff check .",
    "fmt": "oxfmt --write scripts/ test/ packages/ apps/cli/src/ apps/web/src/",
    "fmt:py": "ruff format .",
    "fmt:check": "oxfmt --check scripts/ test/ packages/ apps/cli/src/ apps/web/src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .cache *.log var target dist apps/web/dist",
    "publish:forks": "bun run scripts/vendor/publish_forks.ts",
    "publish:forks:run": "bun run scripts/vendor/publish_forks.ts --publish"
  },
  "dependencies": {
    "oxc-parser": "0.152.0",
    "oxc-transform": "0.152.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
